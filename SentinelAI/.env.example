# ============================================================
# SentinelAI - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ─── Platform ───────────────────────────────────────────────
PLATFORM_NAME=SentinelAI
ENVIRONMENT=development   # development | staging | production
DEBUG=true
LOG_LEVEL=INFO

# ─── JWT & Auth ─────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_USE_OPENSSL_RAND_HEX_64
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
MFA_ISSUER=SentinelAI

# ─── Database (PostgreSQL) ───────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sentinelai
POSTGRES_USER=sentinelai
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql://sentinelai:CHANGE_ME_STRONG_PASSWORD@postgres:5432/sentinelai

# ─── Redis ──────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0

# ─── OpenSearch / Elasticsearch ─────────────────────────────
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=CHANGE_ME_OPENSEARCH_PASSWORD

# ─── Kafka ──────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_LOGS=sentinelai.logs
KAFKA_TOPIC_ALERTS=sentinelai.alerts
KAFKA_TOPIC_EVENTS=sentinelai.events
KAFKA_CONSUMER_GROUP=sentinelai-consumer

# ─── Threat Intelligence APIs ───────────────────────────────
VIRUSTOTAL_API_KEY=YOUR_VIRUSTOTAL_API_KEY
ABUSEIPDB_API_KEY=YOUR_ABUSEIPDB_API_KEY
ALIENVAULT_OTX_KEY=YOUR_OTX_API_KEY
SHODAN_API_KEY=YOUR_SHODAN_API_KEY
MISP_URL=https://your-misp-instance.com
MISP_API_KEY=YOUR_MISP_API_KEY

# ─── AI / LLM ───────────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_OPTIONAL

# ─── SOAR Notifications ─────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@yourcompany.com
SMTP_PASSWORD=YOUR_EMAIL_APP_PASSWORD
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
PAGERDUTY_API_KEY=YOUR_PAGERDUTY_KEY

# ─── Firewall / Network ─────────────────────────────────────
FIREWALL_API_URL=http://firewall-api:8099
FIREWALL_API_KEY=YOUR_FIREWALL_KEY

# ─── Service Ports ──────────────────────────────────────────
AUTH_SERVICE_PORT=8001
LOG_SERVICE_PORT=8002
DETECTION_ENGINE_PORT=8003
AI_SERVICE_PORT=8004
SOAR_SERVICE_PORT=8005
THREAT_INTEL_PORT=8006
ALERT_SERVICE_PORT=8007
REPORT_SERVICE_PORT=8008
VPN_MONITOR_PORT=8009

# ─── Frontend ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_APP_NAME=SentinelAI

# ─── Honeypot ───────────────────────────────────────────────
HONEYPOT_ENABLED=true
HONEYPOT_ALERT_THRESHOLD=3

# ─── Sandbox ────────────────────────────────────────────────
CUCKOO_API_URL=http://cuckoo:8090
CUCKOO_API_KEY=YOUR_CUCKOO_KEY

# ─── RabbitMQ (alternative to Kafka) ────────────────────────
RABBITMQ_URL=amqp://sentinelai:CHANGE_ME_REDIS_PASSWORD@rabbitmq:5672/
RABBITMQ_USER=sentinelai
RABBITMQ_VHOST=/

# ─── OAuth2 SSO ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET
AZURE_CLIENT_SECRET=YOUR_AZURE_CLIENT_SECRET
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000

# ─── OpenCTI ────────────────────────────────────────────────
OPENCTI_URL=https://your-opencti-instance.com
OPENCTI_API_KEY=YOUR_OPENCTI_API_KEY

# ─── Go Metrics Service ─────────────────────────────────────
GO_METRICS_PORT=8015
NEXT_PUBLIC_GO_METRICS_URL=http://localhost:8015

# ─── Traefik ────────────────────────────────────────────────
TRAEFIK_DOMAIN=sentinelai.yourdomain.com
LETSENCRYPT_EMAIL=admin@yourdomain.com

# ─── Osquery Fleet ───────────────────────────────────────────
OSQUERY_FLEET_URL=https://your-fleet.yourdomain.com
OSQUERY_FLEET_TOKEN=YOUR_FLEET_TOKEN

# ─── Cloud Security ─────────────────────────────────────────
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
AWS_DEFAULT_REGION=us-east-1
AZURE_SUBSCRIPTION_ID=YOUR_SUBSCRIPTION_ID
