# ============================================================
# SentinelAI — Suricata IDS Ruleset
# ============================================================

# ── DDoS Detection ───────────────────────────────────────────
alert tcp any any -> $HOME_NET any (msg:"SENTINELAI DDoS SYN Flood"; flags:S; threshold: type both, track by_src, count 100, seconds 5; classtype:attempted-dos; sid:9000001; rev:1;)
alert udp any any -> $HOME_NET any (msg:"SENTINELAI DDoS UDP Flood"; threshold: type both, track by_src, count 500, seconds 5; classtype:attempted-dos; sid:9000002; rev:1;)
alert icmp any any -> $HOME_NET any (msg:"SENTINELAI DDoS ICMP Flood"; threshold: type both, track by_src, count 100, seconds 5; classtype:attempted-dos; sid:9000003; rev:1;)

# ── Port Scanning ─────────────────────────────────────────────
alert tcp any any -> $HOME_NET any (msg:"SENTINELAI Port Scan Detected"; flags:S; threshold: type both, track by_src, count 20, seconds 10; classtype:attempted-recon; sid:9000010; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"SENTINELAI Nmap SYN Scan"; flags:S,!A; threshold: type both, track by_src, count 30, seconds 5; classtype:attempted-recon; sid:9000011; rev:1;)
alert tcp any any -> $HOME_NET 22 (msg:"SENTINELAI SSH Brute Force"; flags:S; threshold: type both, track by_src, count 10, seconds 60; classtype:attempted-admin; sid:9000012; rev:1;)

# ── Reverse Shell Detection ───────────────────────────────────
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"SENTINELAI Possible Reverse Shell Outbound"; content:"bash -i"; classtype:trojan-activity; sid:9000020; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"SENTINELAI Netcat Reverse Shell"; content:"nc -e"; classtype:trojan-activity; sid:9000021; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"SENTINELAI Inbound Shell Command"; content:"/bin/sh"; offset:0; depth:7; classtype:trojan-activity; sid:9000022; rev:1;)

# ── DNS Tunneling ─────────────────────────────────────────────
alert dns any any -> any any (msg:"SENTINELAI DNS Tunneling - Long Subdomain"; dns.query; content:"."; pcre:"/^[a-zA-Z0-9+\/]{40,}\./"; classtype:policy-violation; sid:9000030; rev:1;)
alert dns any any -> any any (msg:"SENTINELAI DNS TXT Record Exfiltration"; dns.query; content:"TXT"; classtype:policy-violation; sid:9000031; rev:1;)

# ── Data Exfiltration ─────────────────────────────────────────
alert tcp $HOME_NET any -> $EXTERNAL_NET !80 (msg:"SENTINELAI Large Outbound Transfer Non-HTTP"; threshold: type threshold, track by_src, count 1, seconds 1; byte_test:4,>,10485760,0; classtype:policy-violation; sid:9000040; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET 443 (msg:"SENTINELAI Excessive HTTPS Upload"; threshold: type threshold, track by_src, count 1000, seconds 60; classtype:policy-violation; sid:9000041; rev:1;)

# ── Malware C2 Beaconing ──────────────────────────────────────
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"SENTINELAI Cobalt Strike Beacon Pattern"; http.uri; content:"/updates.rss"; classtype:trojan-activity; sid:9000050; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"SENTINELAI Possible C2 Beacon Regular Interval"; threshold: type both, track by_src, count 5, seconds 300; classtype:trojan-activity; sid:9000051; rev:1;)

# ── Lateral Movement ─────────────────────────────────────────
alert tcp $HOME_NET any -> $HOME_NET 445 (msg:"SENTINELAI SMB Lateral Movement Scan"; threshold: type both, track by_src, count 10, seconds 30; classtype:attempted-admin; sid:9000060; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET 3389 (msg:"SENTINELAI RDP Lateral Movement"; threshold: type both, track by_src, count 5, seconds 60; classtype:attempted-admin; sid:9000061; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET 22 (msg:"SENTINELAI SSH Lateral Movement"; threshold: type both, track by_src, count 5, seconds 30; classtype:attempted-admin; sid:9000062; rev:1;)

# ── Web Application Attacks ───────────────────────────────────
alert http any any -> $HOME_NET any (msg:"SENTINELAI SQL Injection Attempt"; http.uri; content:"' OR '1'='1"; nocase; classtype:web-application-attack; sid:9000070; rev:1;)
alert http any any -> $HOME_NET any (msg:"SENTINELAI XSS Attempt"; http.uri; content:"<script>"; nocase; classtype:web-application-attack; sid:9000071; rev:1;)
alert http any any -> $HOME_NET any (msg:"SENTINELAI Directory Traversal"; http.uri; content:"../../../"; classtype:web-application-attack; sid:9000072; rev:1;)
alert http any any -> $HOME_NET any (msg:"SENTINELAI Log4Shell RCE Attempt"; http.request_body; content:"${jndi:"; nocase; classtype:attempted-recon; sid:9000073; rev:1;)

# ── Credential Attacks ────────────────────────────────────────
alert http any any -> $HOME_NET any (msg:"SENTINELAI Credential Stuffing High Volume"; threshold: type both, track by_src, count 50, seconds 60; http.method; content:"POST"; classtype:attempted-admin; sid:9000080; rev:1;)
