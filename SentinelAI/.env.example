# ============================================================
# SentinelAI - Environment Configuration TEMPLATE
# Copy this file to .env and replace every placeholder.
# NEVER commit a real .env file, password, token, API key, or
# private key to source control.
# ============================================================

# ─── Platform ───────────────────────────────────────────────
PLATFORM_NAME=SentinelAI
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ─── JWT & Auth ─────────────────────────────────────────────
# Generate a cryptographically random value for local use.
# Example: openssl rand -hex 64
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
MFA_ISSUER=SentinelAI

# ─── Database ───────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sentinelai
POSTGRES_USER=sentinelai
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DATABASE_URL=postgresql://sentinelai:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/sentinelai

# ─── Redis ──────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD@redis:6379/0

# ─── OpenSearch / Elasticsearch ─────────────────────────────
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=REPLACE_WITH_STRONG_OPENSEARCH_PASSWORD

# ─── Kafka ──────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_LOGS=sentinelai.logs
KAFKA_TOPIC_ALERTS=sentinelai.alerts
KAFKA_TOPIC_EVENTS=sentinelai.events
KAFKA_CONSUMER_GROUP=sentinelai-consumer

# ─── Threat Intelligence APIs ───────────────────────────────
VIRUSTOTAL_API_KEY=REPLACE_WITH_VIRUSTOTAL_KEY
ABUSEIPDB_API_KEY=REPLACE_WITH_ABUSEIPDB_KEY
ALIENVAULT_OTX_KEY=REPLACE_WITH_OTX_KEY
SHODAN_API_KEY=REPLACE_WITH_SHODAN_KEY
MISP_URL=https://your-misp-instance.example
MISP_API_KEY=REPLACE_WITH_MISP_KEY

# ─── AI / LLM ───────────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2
ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_KEY_IF_USED

# ─── SOAR Notifications ────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=REPLACE_WITH_EMAIL_APP_PASSWORD
SLACK_WEBHOOK_URL=REPLACE_WITH_SLACK_WEBHOOK
PAGERDUTY_API_KEY=REPLACE_WITH_PAGERDUTY_KEY

# ─── Firewall / Network ─────────────────────────────────────
FIREWALL_API_URL=http://firewall-api:8099
FIREWALL_API_KEY=REPLACE_WITH_FIREWALL_KEY

# ─── Service Ports ──────────────────────────────────────────
AUTH_SERVICE_PORT=8001
LOG_SERVICE_PORT=8002
DETECTION_ENGINE_PORT=8003
AI_SERVICE_PORT=8004
SOAR_SERVICE_PORT=8005
THREAT_INTEL_PORT=8006
ALERT_SERVICE_PORT=8007
REPORT_SERVICE_PORT=8008
VPN_MONITOR_PORT=8009

# ─── Frontend ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_APP_NAME=SentinelAI

# ─── Honeypot ───────────────────────────────────────────────
HONEYPOT_ENABLED=true
HONEYPOT_ALERT_THRESHOLD=3

# ─── Sandbox ────────────────────────────────────────────────
CUCKOO_API_URL=http://cuckoo:8090
CUCKOO_API_KEY=REPLACE_WITH_CUCKOO_KEY

# ─── RabbitMQ ────────────────────────────────────────────────
RABBITMQ_URL=amqp://sentinelai:REPLACE_WITH_RABBITMQ_PASSWORD@rabbitmq:5672/
RABBITMQ_USER=sentinelai
RABBITMQ_VHOST=/

# ─── OAuth2 SSO ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
GITHUB_CLIENT_ID=REPLACE_WITH_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=REPLACE_WITH_GITHUB_CLIENT_SECRET
AZURE_CLIENT_SECRET=REPLACE_WITH_AZURE_CLIENT_SECRET
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000

# ─── OpenCTI ────────────────────────────────────────────────
OPENCTI_URL=https://your-opencti-instance.example
OPENCTI_API_KEY=REPLACE_WITH_OPENCTI_KEY

# ─── Go Metrics Service ─────────────────────────────────────
GO_METRICS_PORT=8015
NEXT_PUBLIC_GO_METRICS_URL=http://localhost:8015

# ─── Traefik ────────────────────────────────────────────────
TRAEFIK_DOMAIN=sentinelai.local
LETSENCRYPT_EMAIL=admin@example.com

# ─── Osquery Fleet ──────────────────────────────────────────
OSQUERY_FLEET_URL=https://fleet.example
OSQUERY_FLEET_TOKEN=REPLACE_WITH_FLEET_TOKEN

# ─── Cloud Security ─────────────────────────────────────────
AWS_ACCESS_KEY_ID=REPLACE_WITH_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_AWS_SECRET_KEY
AWS_DEFAULT_REGION=us-east-1
AZURE_SUBSCRIPTION_ID=REPLACE_WITH_AZURE_SUBSCRIPTION_ID
